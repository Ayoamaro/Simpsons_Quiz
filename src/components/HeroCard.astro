---
interface Props {
  cardImage: string
  title: string
  description: string
  buttonText?: string
  buttonHref?: string
}

const {
  cardImage,
  title,
  description,
  buttonText = '¡EMPEZAR QUIZ!',
  buttonHref = '/quiz',
} = Astro.props
---

<section
  class="relative w-full py-5 bg-cover bg-center flex items-center justify-center"
>
  <!-- Card centrada -->
  <div
    class="bg-yellow-400 border-4 border-black rounded-3xl max-w-2xl w-full mx-4 p-6 md:p-10 shadow-xl"
  >
    <h1
      class="text-3xl md:text-4xl font-extrabold italic text-center uppercase"
    >
      {title}
    </h1>

    <p class="mt-4 text-center font-semibold">
      {description}
    </p>

    <div class="mt-6 rounded-2xl overflow-hidden border-4 border-black">
      <img src={cardImage} alt="" class="w-full h-auto object-cover" />
    </div>

    <div class="mt-6 flex justify-center">
      <a
        href={buttonHref}
        class="bg-white text-black uppercase font-black tracking-widest px-6 py-2 rounded-full border-2 border-black shadow-[4px_4px_0_#000] active:translate-x-0.5 active:translate-y-0.5 active:shadow-[2px_2px_0_#000] hover:brightness-95 transition-all hover:bg-[#91D4F7]"
      >
        {buttonText}
      </a>
    </div>
  </div>
</section>
