---
/**
 * HeroCard.astro
 * ------------------------------------------------------
 * Card principal de la home:
 * - Título + descripción
 * - Imagen central (la proporcionas tú)
 * - CTA configurable (texto + href)
 */

type Props = {
  cardImage: string
  title: string
  description: string
  buttonText?: string
  buttonHref?: string
  imageAlt?: string
}

const {
  cardImage,
  title,
  description,
  buttonText = '¡EMPEZAR QUIZ!',
  buttonHref = '/quiz',
  imageAlt = title,
} = Astro.props

/**
 * Clases reutilizables para el CTA
 */
const cta =
  'bg-white text-black uppercase font-black tracking-widest px-6 py-2 rounded-full border-2 border-black shadow-[4px_4px_0_#000] active:translate-x-0.5 active:translate-y-0.5 active:shadow-[2px_2px_0_#000] hover:brightness-95 transition-all hover:bg-[#91D4F7]'
---

<section
  class="relative flex w-full items-center justify-center bg-cover bg-center py-5"
>
  <!-- Card centrada (cartoon) -->
  <div
    class="mx-4 w-full max-w-2xl rounded-3xl border-4 border-black bg-yellow-400 p-6 shadow-xl md:p-10"
  >
    <h1
      class="text-center text-3xl font-extrabold italic uppercase md:text-4xl"
    >
      {title}
    </h1>

    <p class="mt-4 text-center font-semibold">{description}</p>

    <!-- Imagen -->
    <div class="mt-6 overflow-hidden rounded-2xl border-4 border-black">
      <img
        src={cardImage}
        alt={imageAlt}
        class="h-auto w-full object-cover"
        loading="eager"
        decoding="async"
      />
    </div>

    <!-- CTA -->
    <div class="mt-6 flex justify-center">
      <a href={buttonHref} class={cta}>
        {buttonText}
      </a>
    </div>
  </div>
</section>
