---
/**
 * LoadingResults.astro
 * ------------------------------------------------------
 * Pantalla de carga “cartoon” mientras se calcula el resultado.
 * - Planeta con nubes + anillo giratorio
 * - Mascota centrada (placeholder o personaje)
 * - Tarjeta de progreso (porcentaje + barra)
 */

type Props = {
  title?: string
  subtitle?: string
  hint?: string
  mascotImage?: string
}

const {
  title = 'CONSULTANDO CON EL PROFESOR FRINK...',
  subtitle = 'Calculando tu personalidad...',
  hint = '¡Excelente! Los niveles de radioactividad son normales.',
  mascotImage = '/img/placeholder-character.webp',
} = Astro.props

/**
 * Nubes decorativas del “planeta”
 * Se renderizan con map para evitar repetición de markup.
 */
const clouds = [
  { cls: 'left-8 top-16 h-16 w-28' },
  { cls: 'left-20 top-10 h-14 w-24' },
  { cls: 'right-10 bottom-14 h-16 w-28' },
  { cls: 'right-20 bottom-9 h-14 w-24' },
]

/**
 * Clases reutilizables
 */
const stickerBase =
  'absolute border-2 border-black rounded-full px-3 py-1 text-xs font-black shadow-[3px_3px_0_#000] bg-white'
---

<section class="mx-auto w-full max-w-5xl px-4 py-10">
  <div class="flex flex-col items-center gap-6 text-center">
    <!-- Planeta -->
    <div class="relative">
      <div
        class="relative h-64 w-64 overflow-hidden rounded-full border-4 border-white bg-linear-to-b from-sky-400 to-sky-500 shadow-[0_10px_30px_rgba(0,0,0,0.15)] md:h-72 md:w-72"
      >
        <!-- Nubes -->
        {
          clouds.map(({ cls }) => (
            <div class={`absolute ${cls} rounded-full bg-white/95`} />
          ))
        }

        <!-- Anillo punteado -->
        <div
          class="absolute inset-5 animate-spin-slow rounded-full border-2 border-dashed border-white/70"
        >
        </div>

        <!-- Mascota -->
        <div
          class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 rounded-2xl border-2 border-black bg-white p-3 shadow-[4px_4px_0_#000]"
        >
          <img
            src={mascotImage}
            alt="Personaje"
            class="h-28 w-28 object-contain"
            loading="eager"
          />
        </div>
      </div>

      <!-- Pegatinas -->
      <div class={`${stickerBase} -left-4 top-10`}>¡OH!</div>
      <div class={`${stickerBase} -right-4 bottom-10 bg-[#F2F20D]`}>
        WOO-HOO!
      </div>
    </div>

    <!-- Textos -->
    <div class="space-y-2">
      <h1 class="text-2xl font-black italic tracking-tight md:text-3xl">
        {title}
      </h1>
      <p class="text-sm font-semibold text-black/70 md:text-base">{subtitle}</p>
    </div>

    <!-- Progreso -->
    <div
      class="w-full max-w-xl rounded-2xl border-2 border-black bg-white p-5 text-left shadow-[4px_4px_0_#000]"
    >
      <div class="flex items-center justify-between gap-4">
        <div>
          <p
            class="text-[11px] font-black uppercase tracking-widest text-black/70"
          >
            Estado del sistema
          </p>
          <p class="text-sm font-extrabold">Procesando respuestas</p>
        </div>

        <div class="text-right">
          <p class="text-2xl font-black text-[#F2F20D] drop-shadow">
            <span id="progressPct">0</span>%
          </p>
        </div>
      </div>

      <div
        class="mt-4 h-3 w-full overflow-hidden rounded-full border border-black/20 bg-black/10"
      >
        <div
          id="progressBar"
          class="h-full w-[0%] rounded-full bg-[#F2F20D] transition-[width] duration-300 ease-out"
        >
        </div>
      </div>

      <div
        class="mt-3 flex items-center gap-2 text-xs font-semibold text-black/70"
      >
        <span class="inline-block h-2 w-2 rounded-full bg-lime-500"></span>
        <p>{hint}</p>
      </div>
    </div>
  </div>

  <style>
    /**
     * Animación suave del anillo (10s)
     */
    @keyframes spinSlow {
      to {
        transform: rotate(360deg);
      }
    }
    .animate-spin-slow {
      animation: spinSlow 10s linear infinite;
    }
  </style>
</section>
