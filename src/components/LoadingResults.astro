---
type Props = {
  title?: string
  subtitle?: string
  hint?: string
  mascotImage?: string
}

const {
  title = 'CONSULTANDO CON EL PROFESOR FRINK...',
  subtitle = 'Calculando tu personalidad...',
  hint = '¡Excelente! Los niveles de radioactividad son normales.',
  mascotImage = '/img/placeholder-character.webp',
} = Astro.props
---

<section class="mx-auto w-full max-w-5xl px-4 py-10">
  <div class="flex flex-col items-center text-center gap-6">
    <!-- “Planeta” / círculo -->
    <div class="relative">
      <div
        class="relative h-64 w-64 md:h-72 md:w-72 rounded-full border-4 border-white shadow-[0_10px_30px_rgba(0,0,0,0.15)] bg-linear-to-b from-sky-400 to-sky-500 overflow-hidden"
      >
        <!-- “Nube” simple -->
        <div class="absolute left-8 top-16 h-16 w-28 rounded-full bg-white/95">
        </div>
        <div class="absolute left-20 top-10 h-14 w-24 rounded-full bg-white/95">
        </div>

        <div
          class="absolute right-10 bottom-14 h-16 w-28 rounded-full bg-white/95"
        >
        </div>
        <div
          class="absolute right-20 bottom-9 h-14 w-24 rounded-full bg-white/95"
        >
        </div>

        <!-- anillo punteado -->
        <div
          class="absolute inset-5 rounded-full border-2 border-white/70 border-dashed animate-spin-slow"
        >
        </div>

        <!-- “mascota” (tu personaje final o placeholder) -->
        <div
          class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 bg-white border-2 border-black rounded-2xl shadow-[4px_4px_0_#000] p-3"
        >
          <img
            src={mascotImage}
            alt="Personaje"
            class="h-28 w-28 object-contain"
            loading="eager"
          />
        </div>
      </div>

      <!-- “pegatinas” -->
      <div
        class="absolute -left-4 top-10 bg-white border-2 border-black rounded-full px-3 py-1 text-xs font-black shadow-[3px_3px_0_#000]"
      >
        ¡OH!
      </div>

      <div
        class="absolute -right-4 bottom-10 bg-[#F2F20D] border-2 border-black rounded-full px-3 py-1 text-xs font-black shadow-[3px_3px_0_#000]"
      >
        WOO-HOO!
      </div>
    </div>

    <!-- textos -->
    <div class="space-y-2">
      <h1 class="text-2xl md:text-3xl font-black tracking-tight italic">
        {title}
      </h1>
      <p class="text-sm md:text-base text-black/70 font-semibold">
        {subtitle}
      </p>
    </div>

    <!-- tarjeta progreso -->
    <div
      class="w-full max-w-xl bg-white border-2 border-black rounded-2xl shadow-[4px_4px_0_#000] p-5 text-left"
    >
      <div class="flex items-center justify-between gap-4">
        <div>
          <p
            class="text-[11px] font-black tracking-widest uppercase text-black/70"
          >
            Estado del sistema
          </p>
          <p class="text-sm font-extrabold">Procesando respuestas</p>
        </div>

        <div class="text-right">
          <p class="text-2xl font-black text-[#F2F20D] drop-shadow">
            <span id="progressPct">0</span>%
          </p>
        </div>
      </div>

      <div
        class="mt-4 h-3 w-full rounded-full bg-black/10 border border-black/20 overflow-hidden"
      >
        <div
          id="progressBar"
          class="h-full w-[0%] rounded-full bg-[#F2F20D] transition-[width] duration-300 ease-out"
        >
        </div>
      </div>

      <div
        class="mt-3 flex items-center gap-2 text-xs font-semibold text-black/70"
      >
        <span class="inline-block h-2 w-2 rounded-full bg-lime-500"></span>
        <p>{hint}</p>
      </div>
    </div>
  </div>

  <style>
    @keyframes spinSlow {
      to {
        transform: rotate(360deg);
      }
    }
    .animate-spin-slow {
      animation: spinSlow 10s linear infinite;
    }
  </style>
</section>
