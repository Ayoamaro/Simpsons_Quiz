---
/**
 * QuizProgress.astro
 * ------------------------------------------------------
 * Barra de progreso del quiz (porcentaje + contador).
 */

type Props = {
  current: number
  total: number
}

const { current, total } = Astro.props

/**
 * Porcentaje redondeado (0–100)
 */
const percent = Math.round((current / total) * 100)
---

<div
  class="mx-auto w-full max-w-4xl rounded-2xl border-2 border-black bg-white px-6 py-5 shadow-md"
>
  <!-- Header -->
  <div class="mb-3 flex items-center justify-between text-sm font-semibold">
    <div class="uppercase tracking-wide text-gray-700">Progreso de la caja</div>
    <div class="text-gray-600">{percent}% completado</div>
  </div>

  <!-- Progress bar -->
  <div class="relative h-4 w-full overflow-hidden rounded-full bg-gray-200">
    <div
      class="absolute left-0 top-0 h-full bg-yellow-300 transition-all duration-300"
      style={{ width: `${percent}%` }}
    >
    </div>
  </div>

  <!-- Footer -->
  <div class="mt-3 text-right text-xs text-gray-500">
    {current} de {total} rosquillas
  </div>
</div>
