---
/**
 * CharacterSlider.astro
 * ------------------------------------------------------
 * - Slider horizontal con personajes aleatorios de la API
 * - Mantiene los datos en INGLÉS (como vienen de la API)
 * - Normaliza:
 *   - name -> Title Case (respetando acrónimos)
 *   - occupation -> Title Case (respetando acrónimos)
 *   - portrait_path -> URL válida (CDN / https)
 */

type CharacterItem = {
  name: string
  occupation: string
  portrait: string
}

const API = 'https://thesimpsonsapi.com/api/characters'
const LIMIT = 10

/**
 * String seguro con trim + fallback
 */
const safe = (v: unknown, fb = '') =>
  typeof v === 'string' && v.trim() ? v.trim() : fb

/**
 * Title Case manteniendo acrónimos (FBI, NASA, etc.)
 * - Conserva símbolos/puntuación tal cual
 * - Solo transforma palabras que no parecen acrónimos
 */
const titleCase = (v: unknown) => {
  const text = safe(v)
  if (!text) return ''

  return text
    .split(/\s+/)
    .map((raw) => {
      const word = raw.trim()
      if (!word) return word

      // Extrae solo letras para detectar acrónimos
      const letters = word.replace(/[^a-zA-ZÁÉÍÓÚÜÑáéíóúüñ]/g, '')
      const isAcronym =
        letters.length >= 2 &&
        (letters === letters.toUpperCase() || /[A-Z].*[A-Z]/.test(letters))

      if (isAcronym) return word

      // Respeta prefijos/sufijos de signos (ej: "(teacher)")
      const prefix = word.match(/^[^a-zA-ZÁÉÍÓÚÜÑáéíóúüñ]+/)?.[0] ?? ''
      const suffix = word.match(/[^a-zA-ZÁÉÍÓÚÜÑáéíóúüñ]+$/)?.[0] ?? ''
      const core = word.slice(prefix.length, word.length - suffix.length)
      if (!core) return word

      const lower = core.toLowerCase()
      return prefix + lower[0].toUpperCase() + lower.slice(1) + suffix
    })
    .join(' ')
}

/**
 * Normaliza el retrato:
 * - http -> https
 * - path relativo -> CDN 500px
 */
const portraitUrl = (p: unknown) => {
  const s = safe(p)
  if (!s) return ''
  if (s.startsWith('http://')) return `https://${s.slice(7)}`
  if (s.startsWith('https://')) return s
  return `https://cdn.thesimpsonsapi.com/500${s.startsWith('/') ? s : `/${s}`}`
}

/**
 * Placeholder embebido si falla la imagen
 */
const placeholderDataUrl =
  'data:image/svg+xml;charset=UTF-8,' +
  encodeURIComponent(`
    <svg xmlns="http://www.w3.org/2000/svg" width="300" height="300">
      <rect width="100%" height="100%" fill="#f4f4f5"/>
      <text x="50%" y="50%" text-anchor="middle" dominant-baseline="middle"
            font-family="Arial" font-size="18" fill="#a1a1aa">
        No image
      </text>
    </svg>
  `)

/**
 * Obtiene una página aleatoria leyendo total_pages
 * Si falla, cae a la primera página.
 */
const getRandomPage = async () => {
  try {
    const r = await fetch(`${API}?page=1`)
    const j = await r.json()
    const total =
      Number(j?.total_pages) ||
      Number(j?.totalPages) ||
      Number(j?.meta?.total_pages) ||
      Number(j?.meta?.totalPages) ||
      Number(j?.pagination?.total_pages) ||
      Number(j?.pagination?.totalPages)

    return Number.isFinite(total) && total > 1
      ? Math.floor(Math.random() * total) + 1
      : 1
  } catch {
    return 1
  }
}

const page = await getRandomPage()

/**
 * Descarga y normaliza personajes (name/occupation/portrait)
 */
const fetchCharacters = async (): Promise<CharacterItem[]> => {
  try {
    const r = await fetch(`${API}?page=${page}`)
    const j = await r.json()
    const list =
      j?.data || j?.results || j?.characters || (Array.isArray(j) ? j : [])
    const arr = Array.isArray(list) ? list : []

    return arr.slice(0, LIMIT).map((c: any) => ({
      name: titleCase(c?.name),
      occupation: titleCase(c?.occupation),
      portrait: portraitUrl(c?.portrait_path),
    }))
  } catch {
    return []
  }
}

const items = await fetchCharacters()

/**
 * Clases reutilizables (menos repetición)
 */
const btnBase =
  'inline-flex h-10 w-10 items-center justify-center rounded-full border border-zinc-200 bg-white shadow-sm hover:bg-zinc-50 active:scale-95'
const cardBase =
  'min-w-55 max-w-55 snap-start rounded-2xl bg-white p-4 text-center ring-1 ring-zinc-100 shadow-sm transition-all duration-300 group cursor-pointer hover:scale-105 hover:shadow-xl hover:bg-[#91D4F7]'
---

<section class="w-full" id="personajes">
  <div
    class="mx-auto my-6 w-full max-w-5xl overflow-x-hidden rounded-3xl border-4 border-black bg-yellow-400 px-6 py-8 shadow-xl sm:mx-6 md:py-10 lg:mx-auto"
  >
    <div class="flex items-end justify-between gap-4">
      <div>
        <h1
          class="text-center text-3xl font-extrabold italic uppercase md:text-4xl"
        >
          Conoce a los personajes
        </h1>
        <div class="mt-2 h-1 w-16 rounded bg-yellow-400"></div>
      </div>

      <!-- Controls (desktop) -->
      <div class="hidden items-center gap-2 sm:flex">
        <button type="button" class={`js-prev ${btnBase}`} aria-label="Anterior"
          >←</button
        >
        <button
          type="button"
          class={`js-next ${btnBase}`}
          aria-label="Siguiente">→</button
        >
      </div>
    </div>

    <div class="relative mt-2">
      <div
        class="pointer-events-none absolute inset-y-0 left-0 w-10 bg-linear-to-r"
      >
      </div>
      <div
        class="pointer-events-none absolute inset-y-0 right-0 w-10 bg-linear-to-l"
      >
      </div>

      <div
        class="js-slider no-scrollbar flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth py-2"
      >
        {
          items.length === 0 ? (
            <div class="w-full rounded-xl border border-zinc-200 bg-white p-6 text-zinc-700">
              No se pudieron cargar los personajes. Prueba a recargar.
            </div>
          ) : (
            items.map((it) => (
              <article class={cardBase}>
                <div class="mx-auto grid h-36 w-36 place-items-center overflow-hidden rounded-full bg-white ring-2 ring-black/10">
                  {it.portrait ? (
                    <img
                      src={it.portrait}
                      alt={`Portrait of ${it.name}`}
                      class="h-full w-full object-cover"
                      loading="lazy"
                      decoding="async"
                      referrerpolicy="no-referrer"
                      onerror={`this.onerror=null; this.src='${placeholderDataUrl}';`}
                    />
                  ) : (
                    <div class="grid h-full w-full place-items-center bg-zinc-100 text-sm text-zinc-400">
                      No image
                    </div>
                  )}
                </div>

                <h3 class="mt-4 text-sm font-extrabold tracking-wide text-zinc-900">
                  {it.name}
                </h3>

                <p class="mt-1 line-clamp-3 text-xs font-semibold tracking-wide text-zinc-500">
                  {it.occupation}
                </p>
              </article>
            ))
          )
        }
      </div>
    </div>

    <!-- Controls (mobile) -->
    <div class="mt-6 flex items-center justify-center gap-2 sm:hidden">
      <button type="button" class={`js-prev ${btnBase}`} aria-label="Anterior"
        >←</button
      >
      <button type="button" class={`js-next ${btnBase}`} aria-label="Siguiente"
        >→</button
      >
    </div>
  </div>

  <script is:inline>
    /**
     * Slider controls
     * - Calcula el “paso” según ancho real de una card + gap
     * - Soporta botones duplicados (desktop / mobile)
     */
    ;(() => {
      const root = document.currentScript?.closest('section')
      const slider = root?.querySelector('.js-slider')
      if (!root || !slider) return

      const prevButtons = root.querySelectorAll('.js-prev')
      const nextButtons = root.querySelectorAll('.js-next')

      const getStep = () => {
        const card = slider.querySelector('article')
        if (!card) return 260
        const styles = window.getComputedStyle(slider)
        const gap = parseFloat(styles.columnGap || styles.gap || '0') || 0
        return card.getBoundingClientRect().width + gap
      }

      const scrollByDir = (dir) => {
        slider.scrollBy({ left: dir * getStep(), behavior: 'smooth' })
      }

      prevButtons.forEach((b) =>
        b.addEventListener('click', () => scrollByDir(-1))
      )
      nextButtons.forEach((b) =>
        b.addEventListener('click', () => scrollByDir(1))
      )
    })()
  </script>

  <style>
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</section>
