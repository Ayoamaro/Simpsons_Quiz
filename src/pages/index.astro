---
/**
 * index.astro
 * ------------------------------------------------------
 * Página de inicio del proyecto.
 * - Hero principal con CTA al quiz
 * - Slider de personajes destacados
 */

import BaseLayout from '../layouts/BaseLayout.astro'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import HeroCard from '../components/HeroCard.astro'
import CharacterSlider from '../components/CharacterSlider.astro'
---

<BaseLayout title="The Simpsons Quiz">
  <!-- Navbar -->
  <Navbar slot="nav" />

  <!-- Hero principal -->
  <HeroCard
    cardImage="/img/simpsons-quiz-card.webp"
    title="¿QUÉ PERSONAJE DE LOS SIMPSONS ERES?"
    description="¡Descúbrelo en segundos con nuestro divertido quiz de personalidad! ¿Serás un genio como Lisa o un amante de las rosquillas como Homer?"
  />

  <!-- Slider de personajes -->
  <CharacterSlider />

  <!-- Footer -->
  <Footer slot="footer" />
</BaseLayout>
